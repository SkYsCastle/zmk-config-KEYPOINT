#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define NUM 1
#define SYM 2
#define MOUSE_nav 3
#define BOT bootloader
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 26 27 28 29 30 31 42 43 44 45  // Left-hand keys.
#define KEYS_R 6 7 8 9 10 11 6 7 8 9 10 11 20 21 22 23 24 25 36 37 38 39 40 41 52 53 54 55 // Right-hand keys.
#define THUMBS 46 47 48 49 50 51 18 19 32 33 34 35  // Thumb keys.

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {
        sp_sc: behavior_spacescroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &kp>;        /* hold=none, tap=space */
        };
    };

    behaviors {
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };

        behaviors {
            //以下来自charibdis

            mm_f1: num_or_f1 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp KP_N1>, <&kp F1>;

                mods = <MOD_LSFT>;
            };

            mm_f2: num_or_f2 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp KP_N2>, <&kp F2>;

                mods = <MOD_LSFT>;
            };

            mm_f3: num_or_f3 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp KP_N3>, <&kp F3>;

                mods = <MOD_LSFT>;
            };

            mm_f4: num_or_f4 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp KP_N4>, <&kp F4>;

                mods = <MOD_LSFT>;
            };

            mm_f5: num_or_f5 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp KP_N5>, <&kp F5>;

                mods = <MOD_LSFT>;
            };

            mm_f6: num_or_f6 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp KP_N6>, <&kp F6>;

                mods = <MOD_LSFT>;
            };

            mm_f7: num_or_f7 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp KP_N7>, <&kp F7>;

                mods = <MOD_LSFT>;
            };

            mm_f8: num_or_f8 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp KP_N8>, <&kp F8>;

                mods = <MOD_LSFT>;
            };

            mm_f9: num_or_f9 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp KP_N9>, <&kp F9>;

                mods = <MOD_LSFT>;
            };

            mm_f11: min_or_f11 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp KP_MULTIPLY>, <&kp F11>;

                mods = <MOD_LSFT>;
            };

            mm_f10: slash_or_f10 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp KP_SLASH>, <&kp F10>;

                mods = <MOD_LSFT>;
            };

            mm_f12: zero_or_f12 {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp N0>, <&kp F12>;

                mods = <MOD_LSFT>;
            };

            // Left-hand HRM

            ht_left: left_side_homerow_mod {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "balanced";
                tapping-term-ms = <280>;
                quick-tap-ms = <160>;
                require-prior-idle-ms = <65>;
                retro-tap;
                bindings = <&kp>, <&kp>;

                hold-trigger-key-positions = <KEYS_R THUMBS>;
            };

            // Right-hand HRM

            ht_right: right_side_homerow_mod {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "balanced";
                tapping-term-ms = <280>;
                quick-tap-ms = <160>;
                require-prior-idle-ms = <55>;
                retro-tap;
                bindings = <&kp>, <&kp>;

                hold-trigger-key-positions = <KEYS_L THUMBS>;
            };

            td_esc_l3: td_esc_l3 {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <150>;
                bindings = <&lt 3 ESC>, <&mo 3>;

                // hold, tap, double_tap
            };

            lt_nav: nav_layer_tap {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "tap-preferred";
                tapping-term-ms = <170>;
                bindings = <&mo>, <&kp>;
            };

            td_space_nav: td_space_nav {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <110>;
                bindings = <&lt_nav 3 SPACE>, <&kp SPACE>;

                // hold, tap, double_tap
            };

            mo_clk: mo_click {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "hold-preferred";
                tapping-term-ms = <40>;
                hold-while-undecided;
                bindings = <&mo>, <&mkp>;
            };

            td_clk: td_clk {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <170>;
                bindings = <&mo_clk 2 LCLK>, <&mkp LCLK>;

                // hold, tap, double_tap
            };

            mo_kp: mo_kp {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "hold-preferred";
                tapping-term-ms = <40>;
                hold-while-undecided;
                bindings = <&mo>, <&kp>;
            };

            td_bs_num: td_bs_num {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <170>;
                bindings = <&mo_kp 1 BACKSPACE>, <&kp BACKSPACE>;

                // hold, tap, double_tap
            };

            httl: ht_two_layers {
                compatible = "zmk,behavior-hold-tap";
                bindings = <&mo>, <&to>;

                #binding-cells = <2>;
                flavor = "balanced";
                tapping-term-ms = <125>;
            };

            td_layers: td_layer_swap {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                bindings = <&to 0>, <&to 4>;

                // tap, double_tap
            };

            td_clk_scrl: td_click_or_scroll {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <250>;
                bindings = <&mkp RCLK>, <&mo 8>;

                // tap/hold, double_tap
            };

            td_bore: BASE_or_EXTRA {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                bindings = <&mo 5>, <&to 0>;
            };

            mm_qm_ex: question_exclamation {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp QUESTION>, <&kp EXCLAMATION>;

                mods = <(MOD_LSFT | MOD_RSFT)>;
            };

            mm_pr_col: period_colon {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp PERIOD>, <&kp COLON>;

                mods = <(MOD_LSFT | MOD_RSFT)>;
            };

            mm_cm_sc: comma_semi_colon {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp COMMA>, <&kp SEMICOLON>;

                mods = <(MOD_LSFT | MOD_RSFT)>;
            };

            new_behavior: new_behavior {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <170>;
                bindings = <&mo_clk 2 LCLK>, <&mkp LCLK>;

                label = "NEW_BEHAVIOR";
            };
        };
    };

    combos {
        compatible = "zmk,combos";

        LCL {
            bindings = <&mkp LCLK>;
            key-positions = <13 14>;
        };

        RCL {
            bindings = <&mkp RCLK>;
            key-positions = <15 16>;
        };

        MCL {
            bindings = <&mkp MCLK>;
            key-positions = <14 15>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp C_AC_SEARCH  &kp Q            &kp W                &kp E             &kp R             &kp T    &kp Y       &kp U       &kp I           &kp O              &kp P              &kp BSPC
&kp TAB          &ht_left LCMD A  &ht_left LEFT_ALT S  &ht_left LSHFT D  &ht_left LCTRL F  &kp G    &mkp LCLK   &mkp LCLK   &kp H           &ht_right RCTRL J  &ht_right RSHFT K  &ht_right RALT L  &ht_right RGUI SEMI  &kp ENTER
&kp LSHFT        &kp Z            &kp X                &kp C             &kp V             &kp B    &kp PG_DN   &kp PG_UP   &msc SCRL_DOWN  &msc SCRL_UP       &kp N              &kp M             &mm_cm_sc            &mm_pr_col  &mm_qm_ex  &kp FSLH
&kp LCTRL        &kp LGUI         &kp LALT             &kp CAPSLOCK      &td_esc_l3        &td_clk  &td_bs_num  &td_bs_num  &lt 2 KP_ENTER  &td_space_nav      &kp C_MUTE         &kp MINUS         &kp EQUAL            &kp GRAVE
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN_ARROW UP_ARROW>,
                <&inc_dec_kp LEFT RIGHT>;
        };

        NUM {
            display-name = "num";
            bindings = <
&kp ESC    &trans    &trans    &trans      &trans     &trans         &kp PERCENT  &mm_f7     &mm_f8      &mm_f9      &mm_f10       &kp PLUS
&kp CAPS   &kp LCMD  &kp LALT  &kp LSHFT   &kp LCTRL  &kp BACKSPACE  &mkp RCLK    &mkp RCLK  &kp MINUS   &mm_f4      &mm_f5        &mm_f6    &mm_f11  &kp MINUS
&kp LSHFT  &trans    &trans    &trans      &trans     &kp DEL        &trans       &trans     &bl BL_DEC  &bl BL_INC  &kp EQUAL     &mm_f1    &mm_f2   &mm_f3     &mm_f12  &kp KP_ENTER
&kp LCTRL  &kp LGUI  &trans    &bt BT_CLR  &trans     &trans         &trans       &trans     &kp KP_N0   &kp KP_DOT  &out OUT_TOG  &BOT      &trans   &trans
            >;

            sensor-bindings = <&BLE_encoder &inc_dec_kp UP DOWN>;
        };

        SYM {
            display-name = "sym";
            bindings = <
&kp TILDE  &kp AT     &kp AMPS    &kp F13  &kp F14  &kp AMPS  &kp PLUS  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp AMPS  &kp PRCNT  &kp BSLH
&kp GRAVE  &kp UNDER  &kp LS(N6)  &kp F15  &kp F16  &kp BSPC  &none     &none           &kp MINUS        &kp LPAR  &kp RPAR   &kp LS(N6)        &kp UNDER          &kp PIPE
&kp DLLR   &kp HASH   &kp CARET   &kp LT   &kp GT   &kp DEL   &none     &none           &none            &none     &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp AT    &kp STAR  &kp FSLH
&kp LCTRL  &kp LGUI   &none       &none    &mo 2    &none     &none     &none           &none            &mo 2     &none      &none             &none              &none
            >;
        };

        MOUSE_nav {
            display-name = "MOUSE";
            bindings = <
&trans     &trans    &trans          &mmv MOVE_UP    &trans           &trans         &trans          &trans        &kp UP     &trans          &trans    &trans
&trans     &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp BACKSPACE  &mkp LCLK       &mkp LCLK     &trans     &kp LEFT_ARROW  &kp DOWN  &kp RIGHT_ARROW  &trans   &kp ENTER
&trans     &kp LGUI  &kp LALT        &kp LSHFT       &kp LCTRL        &kp DEL        &msc SCRL_DOWN  &msc SCRL_UP  &none      &none           &trans    &kp HOME         &kp END  &kp PG_UP  &kp PG_DN  &trans
&kp LCTRL  &kp LGUI  &kp LALT        &trans          &trans           &trans         &trans          &mkp LCLK     &mkp RCLK  &mkp MB3        &trans    &trans           &trans   &trans
            >;
        };

        RES_layer {
            display-name = "RESERVE";
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
